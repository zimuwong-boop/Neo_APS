    Item {
        bigint id PK
        string code UK
        string kind
        string unit
        text traceability_info
        string specification
        string product_standard
        string allergens
        int shelf_life_days
        string storage_condition
        int revision
    }
    BOM {
        bigint id PK
        bigint item_id FK
        int version
        decimal output_qty
        string status
        int revision
    }
    BOMLine {
        bigint id PK
        bigint bom_id FK
        bigint component_id FK
        decimal quantity
    }
    SalesOrder {
        bigint id PK
        string number UK
        int priority
        date due_date
        string status
        int revision
    }
    SalesLine {
        bigint id PK
        bigint order_id FK
        bigint item_id FK
        decimal quantity
    }
    Plan {
        uuid id PK
        string name
        string status
        json inputs
        string fingerprint
        json data
        int revision
    }
    Batch {
        uuid id PK
        uuid plan_id FK
    }
    ProductionOrder {
        uuid id PK
        string number UK
        uuid batch_id FK
        bigint item_id FK
        bigint bom_id FK
        string task_key
        decimal quantity
