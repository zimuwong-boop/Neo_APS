        int sequence
        string status
        json snapshot
        json materials
        date target_start
        date target_end
        string line_label
        text notes
        datetime started_at
        int revision
    }
    Allocation {
        bigint id PK
        uuid order_id FK
        bigint sales_line_id FK
        bigint parent_id FK
        string kind
        decimal quantity
        decimal fulfilled_qty
        int priority
        int rank
        text path
        json source
    }
    Report {
        uuid id PK
        uuid order_id FK
        uuid reversal_of_id FK
        string request_key UK
        decimal quantity
        string batch_code
        bigint actor_id FK
        datetime created_at
    }
    ReportAllocation {
        bigint id PK
        uuid report_id FK
        bigint allocation_id FK
        decimal quantity
    }
    User {
        bigint id PK
        string username UK
    }
    Audit {
        bigint id PK
        bigint actor_id FK
        string operation
        string object_id
        json details
        datetime created_at
    }
